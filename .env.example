GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname

# Security
SECRET_KEY= # min 32 chars, e.g. openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — use specific origins in production (e.g. "https://app.example.com")
CORS_ORIGINS=["*"]

# Logging — set to false for plain-text logs during local development
JSON_LOGS=true

# Chat history context window (number of past messages sent to LLM)
HISTORY_LIMIT=15

# LLM call timeout in seconds
LLM_TIMEOUT_SECONDS=60

# Maximum upload file size in MB
MAX_UPLOAD_SIZE_MB=10

# RAG
EMBEDDING_PROVIDER=dummy
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=64
RAG_TOP_K=4
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# Tools / MCP
TOOL_ALLOWLIST=
MCP_SERVERS=[]

# Realtime
SSE_HEARTBEAT_SECONDS=15
WS_PING_INTERVAL=30

# File / S3 (MinIO)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=chat-files
S3_REGION=us-east-1

# Redis
REDIS_URL=redis://redis:6379/0

# Infra
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_STRATEGY=auto
DB_POOL_SIZE=10

# Tracing (OTel)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=backend-chat
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_EMBEDDING_TTL=86400
LLM_CACHE_TTL=600
RETENTION_DAYS=365
GDPR_RETENTION_DAYS=30

# Database
POSTGRES_USER=chat_user
POSTGRES_PASSWORD=chat_password
POSTGRES_DB=chat_db
